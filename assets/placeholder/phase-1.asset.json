{
  "$schema": "./phase-1.asset.schema.json",
  "assetVersion": 1,
  "compatibility": {
    "minimumRuntimeVersion": 1,
    "maximumRuntimeVersion": 1
  },
  "canvas": {
    "width": 160,
    "height": 120,
    "pixelDensity": 1,
    "origin": {
      "x": 0,
      "y": 0
    }
  },
  "layers": [
    {
      "id": "body-placeholder",
      "order": 0,
      "source": "placeholder.txt",
      "slot": "body"
    }
  ],
  "slots": [
    { "id": "body", "x": 80, "y": 60 },
    { "id": "face", "x": 80, "y": 48 },
    { "id": "shadow", "x": 80, "y": 112 },
    { "id": "accessory", "x": 80, "y": 20 }
  ],
  "clips": [
    {
      "id": "idle",
      "durationMilliseconds": 1000,
      "loop": true,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": [
        {
          "targetLayer": "body-placeholder",
          "property": "ScaleY",
          "keyframes": [
            { "timeMilliseconds": 0, "value": 1 },
            { "timeMilliseconds": 500, "value": 1.02 },
            { "timeMilliseconds": 1000, "value": 1 }
          ]
        }
      ]
    },
    {
      "id": "wander",
      "durationMilliseconds": 800,
      "loop": true,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": [
        {
          "targetLayer": "body-placeholder",
          "property": "TranslationX",
          "keyframes": [
            { "timeMilliseconds": 0, "value": 0 },
            { "timeMilliseconds": 800, "value": 12 }
          ]
        }
      ]
    },
    {
      "id": "approach-island",
      "durationMilliseconds": 600,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "climb-up",
      "durationMilliseconds": 500,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "on-island",
      "durationMilliseconds": 1000,
      "loop": true,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "climb-down",
      "durationMilliseconds": 500,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "dragged",
      "durationMilliseconds": 250,
      "loop": true,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "falling",
      "durationMilliseconds": 350,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "landing",
      "durationMilliseconds": 300,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    },
    {
      "id": "reacting",
      "durationMilliseconds": 400,
      "loop": false,
      "frames": [
        { "timeMilliseconds": 0, "layers": ["body-placeholder"] }
      ],
      "transformTracks": []
    }
  ],
  "actions": {
    "Idle": "idle",
    "Wander": "wander",
    "ApproachIsland": "approach-island",
    "ClimbUp": "climb-up",
    "OnIsland": "on-island",
    "ClimbDown": "climb-down",
    "Dragged": "dragged",
    "Jumping": "falling",
    "Falling": "falling",
    "Landing": "landing",
    "Reacting": "reacting"
  },
  "anchors": [
    { "id": "ground-contact", "x": 80, "y": 120 },
    { "id": "click", "x": 80, "y": 52 },
    { "id": "island-grab", "x": 80, "y": 92 },
    { "id": "island-stand", "x": 80, "y": 112 }
  ],
  "hitShapes": [
    {
      "id": "click",
      "purpose": "Click",
      "kind": "Ellipse",
      "bounds": { "x": 20, "y": 10, "width": 120, "height": 100 }
    },
    {
      "id": "drag",
      "purpose": "Drag",
      "kind": "Ellipse",
      "bounds": { "x": 16, "y": 8, "width": 128, "height": 108 }
    },
    {
      "id": "collision",
      "purpose": "Collision",
      "kind": "Rectangle",
      "bounds": { "x": 28, "y": 20, "width": 104, "height": 100 }
    }
  ],
  "events": [
    {
      "clip": "climb-up",
      "timeMilliseconds": 250,
      "name": "island-grabbed",
      "anchor": "island-grab"
    },
    {
      "clip": "landing",
      "timeMilliseconds": 250,
      "name": "landed",
      "anchor": "ground-contact"
    }
  ],
  "fallbacks": [
    { "from": "reacting", "to": "idle" }
  ]
}
