<Window x:Class="Dango.Desktop.Rendering.Visuals.SoftBodyPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dango.Desktop.Rendering.Visuals"
        Title="Dango 落地果冻感调参台" Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Background="#FFF5F1EA" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/></Style>
        <Style TargetType="ToggleButton"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/></Style>
        <Style TargetType="Expander"><Setter Property="Margin" Value="0,0,0,8"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2">
            <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="#FF2B201E" Text="落地果冻感调参台"/>
            <TextBlock Margin="0,5,0,12" Foreground="#FF74645E" Text="空中圆形 → 地面挤压 → 极小回弹 → 底部压平、下半部外鼓的常态；所有形变来自 Box2D。"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,18,0">
            <Border Background="White" CornerRadius="22" BorderBrush="#FFE9DED4" BorderThickness="1">
                <Grid>
                    <Canvas x:Name="GroundCanvas" ClipToBounds="True"><Rectangle x:Name="GroundLine" Height="3" Fill="#FFD7C7B8" Width="620" Canvas.Left="20" Canvas.Top="465"/></Canvas>
                    <local:DeformableDangoVisual x:Name="PreviewDango" HorizontalAlignment="Center" VerticalAlignment="Center" LayoutTransform="3 0 0 3 0 0"/>
                    <Border x:Name="ComparePanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="12" Background="#EFFFFFFF" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="4"><Ellipse Width="70" Height="70" Fill="#FFFFE8C2"/><TextBlock Text="空中圆形" HorizontalAlignment="Center"/></StackPanel>
                            <StackPanel Margin="12,4,4,4"><Border Width="84" Height="62" CornerRadius="38,38,25,25" Background="#FFFFE8C2"/><TextBlock Text="落地常态" HorizontalAlignment="Center"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StateText" Margin="18" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#FF74645E"/>
                </Grid>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParameterPanel">
                <Expander Header="常态轮廓" IsExpanded="True"><StackPanel x:Name="ShapeParameters"/></Expander>
                <Expander Header="落地动作" IsExpanded="True"><StackPanel x:Name="LandingParameters"/></Expander>
                <Expander Header="果冻材质"><StackPanel x:Name="MaterialParameters"/></Expander>
                <Expander Header="地面接触"><StackPanel x:Name="ContactParameters"/></Expander>
                <Expander Header="模拟质量"><StackPanel x:Name="QualityParameters"/></Expander>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <WrapPanel>
                <Button x:Name="ResetDropButton" Click="OnResetDrop" Content="重新下落"/>
                <ToggleButton x:Name="PauseToggle" Content="暂停"/>
                <ToggleButton x:Name="SlowMotionToggle" Content="慢动作 0.25×"/>
                <ToggleButton x:Name="CompareToggle" Checked="OnDisplayOptionChanged" Unchecked="OnDisplayOptionChanged" Content="空中/常态对比"/>
                <ToggleButton x:Name="DebugToggle" Checked="OnDisplayOptionChanged" Unchecked="OnDisplayOptionChanged" Content="节点/弹簧"/>
                <ToggleButton x:Name="ContourOnlyToggle" Checked="OnDisplayOptionChanged" Unchecked="OnDisplayOptionChanged" Content="仅看轮廓"/>
                <Button x:Name="ResetDefaultsButton" Click="OnResetDefaults" Content="恢复默认"/>
                <Button x:Name="SaveButton" Click="OnSave" Content="保存 JSON"/>
                <Button x:Name="LoadButton" Click="OnLoad" Content="加载 JSON"/>
            </WrapPanel>
            <TextBlock x:Name="MetricsText" Grid.Row="1" Margin="5,8,0,0" Foreground="#FF625550" Text="等待物理帧"/>
        </Grid>
    </Grid>
</Window>
