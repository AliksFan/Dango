<UserControl x:Class="Dango.Desktop.Rendering.Visuals.DeformableDangoVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160"
             Height="120"
             Background="Transparent">
    <Grid ClipToBounds="False">
        <Path x:Name="FallbackBodyPath"
              Fill="#FFFFE8C2"
              IsHitTestVisible="False" />
        <Path x:Name="BodyPath"
              Fill="#FFFFE8C2"
              IsHitTestVisible="False" />
        <Canvas x:Name="DebugLayer" Width="160" Height="120" IsHitTestVisible="False" />
        <Canvas x:Name="LeftEyeLayer"
                Width="160"
                Height="120"
                IsHitTestVisible="False">
            <Ellipse Canvas.Left="55" Canvas.Top="59" Width="12" Height="12" Fill="#FF2B201E" />
        </Canvas>
        <Canvas x:Name="RightEyeLayer"
                Width="160"
                Height="120"
                IsHitTestVisible="False">
            <Ellipse Canvas.Left="93" Canvas.Top="59" Width="12" Height="12" Fill="#FF2B201E" />
        </Canvas>
        <Canvas x:Name="HatLayer"
                Width="160"
                Height="120"
                RenderTransformOrigin="0.5,0.125"
                IsHitTestVisible="False">
            <Path Data="M77,25 C77,20 78,16 80,12 C83,16 84,21 83,26 Z" Fill="#FF67B84E" />
            <Path Data="M80,15 C71,15 64,11 62,4 C70,2 77,5 80,15 Z" Fill="#FF78C85A" />
            <Path Data="M80,15 C89,15 96,11 98,4 C90,2 83,5 80,15 Z" Fill="#FF78C85A" />
        </Canvas>
    </Grid>
</UserControl>
