<UserControl x:Class="Dango.Desktop.AppShell.ControlCenter.ProductHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="560" MaxWidth="560" HorizontalAlignment="Center" Margin="16,6,16,10">
            <TextBlock HorizontalAlignment="Center" Margin="0,0,0,16" FontSize="27" FontWeight="SemiBold"
                       Foreground="#3F342D" Text="我的团子" />

            <Grid Width="228" Height="202" HorizontalAlignment="Center"
                  AutomationProperties.Name="团子装饰图形">
                <Ellipse Width="210" Height="174" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Fill="#FFFFD9C5" Stroke="#FFEAB79D" StrokeThickness="2" />
                <Ellipse Width="13" Height="17" Margin="-57,0,0,0" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Fill="#FF6B5147" />
                <Ellipse Width="13" Height="17" Margin="57,0,0,0" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Fill="#FF6B5147" />
                <Path Data="M 108,120 Q 114,125 120,120" Stroke="#FF9C6758" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="22" Height="9" Margin="-112,33,0,0" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Fill="#44E9898B" />
                <Ellipse Width="22" Height="9" Margin="112,33,0,0" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Fill="#44E9898B" />
            </Grid>

            <TextBlock x:Name="DesktopStateText" Margin="0,10,0,0" HorizontalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="#3F342D"
                       Text="正在读取桌面状态" />
            <TextBlock x:Name="HostStatusText" Margin="8,5,8,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#6B625C" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="VisibilityButton" AutomationProperties.Name="切换桌面团子显示"
                        MinWidth="150" Background="#FFF1D5C2" Click="OnVisibilityClick"
                        Content="隐藏桌面团子" />
                <Button Margin="12,0,0,0" MinWidth="125" AutomationProperties.Name="打开桌面设置"
                        Click="OnSettingsClick" Content="桌面设置" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="RetryButton" AutomationProperties.Name="重试初始化" Visibility="Collapsed"
                        Click="OnRetryClick" Content="重试初始化" />
                <Button x:Name="RestoreButton" Margin="8,0,0,0" AutomationProperties.Name="恢复团子"
                        Click="OnRestoreClick" Content="恢复团子" />
            </StackPanel>

            <TextBlock x:Name="CommandStatusText" Margin="8,10,8,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#6B625C" />
            <TextBlock x:Name="SaveStatusText" Margin="8,6,8,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Foreground="#8C573F" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
