                                        <StackPanel Orientation="Horizontal"><Path Data="M4,3 L17,3 L21,7 L21,21 L4,21 Z M8,10 L17,10 M8,14 L17,14 M8,18 L14,18" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.6" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock x:Name="ShowDiagnosticsLabel" Text="查看诊断" /></StackPanel>
                                    </Button>
                                    <TextBox x:Name="SettingsDiagnosticsText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap"
                                             PreviewMouseWheel="OnSettingsDiagnosticsWheel"
                                             Margin="0,12,0,0" Padding="10" BorderBrush="{DynamicResource HomeLine}" Background="Transparent"
                                             MinHeight="90" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="当前场景诊断详情" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </local:SettingsScrollViewer>
            <Grid x:Name="SettingsFooter" Grid.Row="2" Margin="38,8,38,10" MaxWidth="610">
                <Button x:Name="SettingsExitButton" HorizontalAlignment="Left" Click="OnExitSettingsClick" AutomationProperties.Name="退出 Dango">
                    <StackPanel Orientation="Horizontal"><Path Data="M10,3 L3,3 L3,21 L10,21 M9,12 L22,12 M17,7 L22,12 L17,17" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.6" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="退出 Dango" /></StackPanel>
                </Button>
            </Grid>
        </Grid>
        <StackPanel x:Name="HomeFooter" Grid.Row="3" Margin="22,4,22,9">
            <Button x:Name="NoticeButton" Visibility="Collapsed" Style="{StaticResource ToolButton}" FontSize="12"
                    Content="需要处理 · 查看" HorizontalAlignment="Left" Click="OnNoticeClick" />
        </StackPanel>
    </Grid>
</UserControl>
