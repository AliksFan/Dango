<UserControl x:Class="Dango.Desktop.AppShell.ControlCenter.ProductHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visuals="clr-namespace:Dango.Desktop.Rendering.Visuals"
             xmlns:rooms="clr-namespace:Dango.Desktop.AppShell.Rooms"
             xmlns:theme="clr-namespace:Dango.Desktop.Resources"
             xmlns:local="clr-namespace:Dango.Desktop.AppShell.ControlCenter"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Background="{DynamicResource HomeBackground}" Foreground="{DynamicResource HomeInk}" FontSize="14"
             FontFamily="Segoe UI, Microsoft YaHei" UseLayoutRounding="True"
             PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" SizeChanged="OnHomeSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Dango.Desktop;component/Resources/DesktopPalette.xaml" />
            <ResourceDictionary Source="/Dango.Desktop;component/Resources/DesktopButtons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="SettingsScrollGrip" Color="#B7A28E" />
        <Style x:Key="ShortcutKeycap" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Home preserves selected-hover chrome; accessory-only defaults remain separate. -->
        <Style TargetType="Button" BasedOn="{StaticResource DesktopButton}">
            <Setter Property="theme:DesktopTheme.PreserveSelectedHover" Value="True" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource HomeMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource HomeAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="FaceIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSoft}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSoft}" /></Trigger>
                            <Trigger Property="Tag" Value="Selected"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSelected}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSelected}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Selected">
                    <Setter Property="BorderBrush" Value="{DynamicResource HomeAccent}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Launcher" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="22" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource HomeAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="22" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HomeSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BodyParameterSlider" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="FocusOutline" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource HomeAccent}" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="28" Height="26">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent"><Ellipse x:Name="Grip" Width="12" Height="12" Fill="{DynamicResource HomeAccent}" /></Grid>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
                                                        <Setter TargetName="Grip" Property="Width" Value="14" />
                                                        <Setter TargetName="Grip" Property="Height" Value="14" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" Background="{DynamicResource HomeLine}" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusOutline" Property="Background" Value="{DynamicResource HomeSoft}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource HomeLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,14" />
        </Style>
        <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="6" CornerRadius="3" Margin="0,2"
                                    Background="{DynamicResource SettingsScrollGrip}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource HomeAccent}" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource HomeAccent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Border Width="6" CornerRadius="3" Background="{DynamicResource HomeSoft}" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource SettingsScrollThumb}" /></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsScroll" TargetType="local:SettingsScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingsScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="False" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                       Style="{StaticResource SettingsScrollBar}" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TopNavigation" Margin="22,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Brand" Text="Dango" FontSize="18" Height="28" VerticalAlignment="Center" Margin="0,0,20,0" />
            <Viewbox x:Name="FaceBrandIcon" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Visibility="Collapsed" IsHitTestVisible="False" ToolTip="捏脸" AutomationProperties.Name="捏脸">
                <Canvas Width="24" Height="24">
                    <Path Data="M3,16 C3,10 7,7 12,7 C17,7 21,10 21,16 C21,20 17,21 12,21 C7,21 3,20 3,16 Z M12,7 L12,3 M12,5 Q7,5 7,2 Q11,2 12,5 M12,5 Q17,5 17,2 Q13,2 12,5"
                          Stroke="{DynamicResource HomeInk}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                    <Ellipse Width="2.5" Height="3" Canvas.Left="7.5" Canvas.Top="13" Fill="{DynamicResource HomeInk}" />
                    <Ellipse Width="2.5" Height="3" Canvas.Left="14" Canvas.Top="13" Fill="{DynamicResource HomeInk}" />
                </Canvas>
            </Viewbox>
            <Viewbox x:Name="AccessoryBrandIcon" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Visibility="Collapsed" IsHitTestVisible="False" ToolTip="换装" AutomationProperties.Name="换装">
                <Canvas Width="24" Height="24">
                    <Path Data="M8,4 L3,7 L1,12 L6,14 L7,11 L7,21 L17,21 L17,11 L18,14 L23,12 L21,7 L16,4 Q12,9 8,4 Z"
                          Stroke="{DynamicResource HomeInk}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
            <StackPanel x:Name="MainNavigation" Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="HomeNavigation" Content="我的团子" Style="{StaticResource NavButton}"
                        BorderBrush="{DynamicResource HomeAccent}" Foreground="{DynamicResource HomeInk}"
                        AutomationProperties.Name="我的团子" Click="OnHomeClick" Visibility="Collapsed" IsTabStop="False" />
            </StackPanel>
            <StackPanel x:Name="ToolsNavigation" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="好友" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="好友 · 未开发" AutomationProperties.Name="好友，未开发"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource ToolButton}" Click="OnSettingsClick" AutomationProperties.Name="设置"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Content="登录" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="登录 · 未开发" AutomationProperties.Name="登录，未开发"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PorchBrand" Text="门廊" FontSize="18" Margin="22,8"
                   VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="SettingsFeedbackBar" Grid.Row="1" Visibility="Collapsed" Margin="38,0,38,0" Padding="12,8"
                Background="{DynamicResource HomeSoft}" BorderBrush="{DynamicResource HomeLine}" BorderThickness="1" CornerRadius="7">
            <StackPanel>
                <TextBlock x:Name="SettingsFeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource HomeInk}"
                           AutomationProperties.LiveSetting="Polite" />
                <Border x:Name="SaveWarningRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="RetrySaveSettingsButton" Click="OnRetrySaveClick" Margin="0,0,8,4" AutomationProperties.Name="重试保存设置">
                            <StackPanel Orientation="Horizontal"><Path Data="M4,9 A9,9 0 1 1 4,16 M4,3 L4,9 L10,9" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.6" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Text="重试保存" /></StackPanel>
                        </Button>
                        <Button x:Name="RecoverSettingsButton" Content="备份并恢复保存" Click="OnRecoverSettingsClick" Visibility="Collapsed" Margin="0,0,0,4" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="HomeContent" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                      SizeChanged="OnHomeContentSizeChanged"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <Grid x:Name="Stage" Margin="24,10,24,10" MinHeight="330" SizeChanged="OnStageSizeChanged"
                  ClipToBounds="False" Background="Transparent" Focusable="True" MouseDown="OnStageMouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PresenceStageRow" Height="*" />
                    <RowDefinition x:Name="DetailStageRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="57*" />
                    <ColumnDefinition x:Name="GapColumn" Width="46" />
                    <ColumnDefinition x:Name="RightColumn" Width="43*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Presence" Grid.RowSpan="2" Grid.ColumnSpan="3" Width="270" Margin="0,100,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="PresenceTranslation" /></StackPanel.RenderTransform>
                    <Grid x:Name="PetVisualArea" Height="180">
                    <Ellipse x:Name="PetShadow" Width="148" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Margin="0,180,0,0" Opacity="0.17" IsHitTestVisible="False" Focusable="False" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill><RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#443D34" Offset="0" />
                            <GradientStop Color="#80443D34" Offset="0.55" />
                            <GradientStop Color="#00443D34" Offset="1" />
                        </RadialGradientBrush></Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PetShadowScale" />
                                <TranslateTransform x:Name="PetShadowTranslation" />
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Viewbox x:Name="PetPreview" Width="240" Height="180" HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="Fill" RenderTransformOrigin="0.5,0.5"
                             ToolTip="未绑定实时场景的界面预览" AutomationProperties.Name="团子实时预览">
                        <Viewbox.RenderTransform><ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" /></Viewbox.RenderTransform>
                        <Canvas x:Name="LiveSceneCanvas" Width="160" Height="120" ClipToBounds="False" Background="Transparent">
                            <Canvas x:Name="LiveEntityLayer" Width="160" Height="120" ClipToBounds="False">
                                <visuals:DeformableDangoVisual x:Name="LiveDangoVisual" ShowHat="False" IsHitTestVisible="False" />
                                <visuals:DangoHatVisual x:Name="LiveDangoHat" IsHitTestVisible="False" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="LiveSceneStatusText" Text="界面预览 · 无实时场景" FontSize="12" TextAlignment="Center"
                               Foreground="{DynamicResource HomeMuted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <Canvas x:Name="Launchers" Grid.RowSpan="2" Grid.ColumnSpan="3" VerticalAlignment="Top">
                        <Button x:Name="EnterRoomButton" Style="{StaticResource Launcher}"
                                Click="OnEnterRoomClick" ToolTip="F · 进入门廊，前往房间" AutomationProperties.Name="F · 进入门廊，前往房间">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ShortcutKeycap}">
                                    <TextBlock Text="F" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24" IsHitTestVisible="False">
                                    <Path Data="M5,21 L5,3 L19,3 L19,21 M3,21 L21,21 M8,21 L8,6 L16,4 L16,21 Z M13,13 L14,13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas></Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FaceButton" Style="{StaticResource Launcher}" Click="OnFaceClick" ToolTip="E · 捏脸" AutomationProperties.Name="E · 捏脸">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ShortcutKeycap}">
                                    <TextBlock Text="E" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24" IsHitTestVisible="False">
                                    <Path Data="M3,16 C3,10 7,7 12,7 C17,7 21,10 21,16 C21,20 17,21 12,21 C7,21 3,20 3,16 Z M12,7 L12,3 M12,5 Q7,5 7,2 Q11,2 12,5 M12,5 Q17,5 17,2 Q13,2 12,5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                    <Ellipse Width="2.5" Height="3" Canvas.Left="7.5" Canvas.Top="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Ellipse Width="2.5" Height="3" Canvas.Left="14" Canvas.Top="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Canvas></Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="WardrobeButton" Style="{StaticResource Launcher}" Click="OnWardrobeClick" ToolTip="Q · 换装" AutomationProperties.Name="Q · 换装">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ShortcutKeycap}">
                                    <TextBlock Text="Q" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24" IsHitTestVisible="False">
                                    <Path Data="M8,4 L3,7 L1,12 L6,14 L7,11 L7,21 L17,21 L17,11 L18,14 L23,12 L21,7 L16,4 Q12,9 8,4 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                </Canvas></Viewbox>
                            </StackPanel>
                        </Button>
                </Canvas>
                <Grid x:Name="EditorPanel" Grid.Column="2" Opacity="0" Visibility="Hidden" IsEnabled="False" IsHitTestVisible="False"
                      Margin="4,10,4,10" MinHeight="310" VerticalAlignment="Top" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="外观预览选项">
                    <Grid.RenderTransform><TranslateTransform x:Name="PanelTranslation" X="46" /></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition x:Name="EditorHeadingRow" Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="EditorHeading">
                        <TextBlock x:Name="EditorTitle" Text="捏脸" FontSize="15" VerticalAlignment="Center" />
                        <Button x:Name="CloseEditorButton" Content="×" FontSize="20" Width="36" MinHeight="36" Height="36"
                                HorizontalAlignment="Right" BorderBrush="Transparent" Padding="0" Click="OnCloseClick"
                                ToolTip="收起" AutomationProperties.Name="收起选项" />
                    </Grid>
                    <ScrollViewer x:Name="OptionsBody" Grid.Row="1" Margin="0,26,0,20"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Focusable="False">
                      <Grid>
                        <StackPanel x:Name="FaceOptions">
                            <StackPanel.Resources><Style TargetType="Slider" BasedOn="{StaticResource BodyParameterSlider}" /></StackPanel.Resources>
                            <StackPanel x:Name="AppearanceColorsPanel">
                                <TextBlock Text="身体" Margin="0,0,0,8" />
                                <Button x:Name="BodyColorPickerButton" Click="OnBodyColorPickerClick" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal"><Border x:Name="BodyColorSwatch" Width="24" Height="24" BorderBrush="#807568" BorderThickness="1" Margin="0,0,10,0" /><TextBlock x:Name="BodyColorHex" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <WrapPanel x:Name="Colors" Margin="0,0,0,22">
                                    <Button x:Name="CreamButton" Style="{StaticResource ColorButton}" Tag="#FFE8C2" Click="OnColorClick" ToolTip="奶油" AutomationProperties.Name="奶油">
                                        <Grid Width="30" Height="30"><Ellipse Fill="#FFE8C2" /><TextBlock x:Name="CreamCheck" Text="✓" Foreground="#44382B" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
